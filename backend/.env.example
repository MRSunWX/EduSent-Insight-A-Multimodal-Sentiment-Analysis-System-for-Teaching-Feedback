# Optional cloud/locally hosted OpenAI-compatible endpoint.
# The application works without these values using the built-in AEF-R Lite engine.
ENABLE_LLM=false
# Gemini 官方 OpenAI 兼容入口；也可换成其他 OpenAI 兼容服务或本地服务。
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_KEY=
OPENAI_MODEL=gemini-2.5-flash

# 使用本机 Ollama + Qwen3.5 时改为：
# ENABLE_LLM=true
# OPENAI_BASE_URL=http://127.0.0.1:11435/v1
# OPENAI_API_KEY=ollama-local
# OPENAI_MODEL=qwen3.5:9b
# LOCAL_QWEN=true
# OLLAMA_MODELS_PATH=/path/to/your/ollama/models
# LOCAL_QWEN_HOST=127.0.0.1:11435

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
